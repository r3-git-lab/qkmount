# Optional local build overrides.
#
# You almost certainly do NOT need this file. If `go` and the FUSE headers
# (Linux: libfuse3-dev · macOS: macFUSE · Windows: WinFsp) are installed in the
# normal places, `make build` works as-is.
#
# Only use this if your toolchain lives somewhere unusual. Copy it to
# `hack/env.sh` (which is git-ignored) and uncomment/edit as needed; the
# Makefile sources `hack/env.sh` automatically when it exists.
#
#   cp hack/env.sh.example hack/env.sh
#
# export PATH="$HOME/go/bin:$PATH"
# export CGO_CFLAGS="-I$HOME/fuse3/include"

export CGO_ENABLED=1
